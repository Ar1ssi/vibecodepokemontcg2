{
  "name": "ptcg-sim",
  "version": "1.5.1",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "pnpm -C server start",
    "test:2p": "node two-player-sync-test.mjs",
    "test:flip": "node flip-gate-test.mjs",
    "test:inspector": "node test-card-inspector-e2e.mjs",
    "test:reset-choice": "node reset-during-choice-test.mjs",
    "test": "node --test \"shared/**/*.test.mjs\" \"client/**/*.test.mjs\" \"server/**/*.test.mjs\" \"bot/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "audit:oracle": "node scripts/audit-oracle.mjs",
    "audit:abilities": "node scripts/audit-ability-behaviour.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "nodemon": "^3.1.9",
    "playwright": "^1.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
