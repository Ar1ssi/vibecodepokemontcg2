{
  "name": "ptcg-sim",
  "version": "1.5.1",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "pnpm -C server start",
    "test:2p": "node scripts/e2e/two-player-sync-test.mjs",
    "test:solo": "node scripts/e2e/solo-authority-test.mjs",
    "test:board3d": "node scripts/e2e/board3d-view-test.mjs",
    "test:board3d-input": "node scripts/e2e/board3d-input-test.mjs",
    "test:board3d-drag": "node scripts/e2e/board3d-drag-test.mjs",
    "test:board3d-overlays": "node scripts/e2e/board3d-overlays-test.mjs",
    "test:board3d-pick": "node scripts/e2e/board3d-pick-test.mjs",
    "test:board3d-boot": "node scripts/e2e/board3d-boot-test.mjs",
    "test:flip": "node scripts/e2e/flip-gate-test.mjs",
    "test:inspector": "node scripts/e2e/test-card-inspector-e2e.mjs",
    "test:fullview": "node scripts/e2e/fullview-test.mjs",
    "test:spectator": "node scripts/e2e/spectator-view-test.mjs",
    "test:reset-choice": "node scripts/e2e/reset-during-choice-test.mjs",
    "test:opening-coin": "node scripts/e2e/opening-coin-choice-test.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "gates": "node scripts/gates-needed.mjs",
    "harness:check": "node scripts/harness-check.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test": "node --test \"shared/**/*.test.mjs\" \"client/**/*.test.mjs\" \"server/**/*.test.mjs\" \"bot/**/*.test.mjs\" \"scripts/**/*.test.mjs\" && node scripts/record-green-tree.mjs",
    "sfx:import": "node scripts/sfx/import-tcgl-sfx.mjs",
    "fx:import-status": "node scripts/fx/import-tcgl-status-fx.mjs",
    "fx:import-attack": "node scripts/fx/attack/import-tcgl-attack-fx.mjs",
    "fx:import-coins": "node scripts/fx/coin/import-tcgl-coins.mjs",
    "fx:import-deckbox": "node scripts/fx/deckbox/import-tcgl-deckbox.mjs",
    "foil:import": "node scripts/tcgl-foil/import-foil.mjs",
    "foil:upload": "node scripts/tcgl-foil/upload-foil.mjs",
    "custom-sets:publish": "node scripts/custom-sets/publish.mjs",
    "audit:oracle": "node scripts/audit-oracle.mjs",
    "audit:abilities": "node scripts/audit-ability-behaviour.mjs",
    "audit:trainers": "node scripts/audit-trainer-behaviour.mjs",
    "audit:attacks": "node scripts/audit-attack-behaviour.mjs",
    "vendor:species-stats": "node scripts/vendor-species-stats.mjs",
    "meta:refresh": "node scripts/limitless/build-meta-dataset.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "nodemon": "^3.1.9",
    "playwright": "^1.63.0",
    "three": "0.185.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
