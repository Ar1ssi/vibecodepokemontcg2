<!DOCTYPE html>
<html lang="en">
<head>
    <% const isBuilderWindow = typeof builderWindow !== 'undefined' && builderWindow; %>
    <% const isBuildBattle = isBuilderWindow && typeof builderMode !== 'undefined' && builderMode === 'build-battle'; %>
    <% const isHomebrewBattle = isBuildBattle && typeof builderFlow !== 'undefined' && builderFlow === 'homebrew'; %>
    <title><%= isHomebrewBattle ? 'Homebrew Build & Battle | PTCG-sim' : isBuildBattle ? 'Build & Battle | PTCG-sim' : isBuilderWindow ? 'Deck Builder | PTCG-sim' : 'PTCG-sim | Pokémon TCG Tabletop Simulator' %></title>
    <meta name="description" content="PTCG-sim is an open-source Pokémon Trading Card Game (Pokémon TCG) tabletop simulator supporting single player and online multiplayer. Simulate your favorite card game!">
    <meta name="keywords" content="ptcg sim,ptcg,pokemon trading card game simulator,pokemon trading card game sim,pokemon tcg simulator,pokemon tcg sim,pokemon sim,pokemon simulator,pokemon card simulator,pokemon card sim,pokemon tabletop simulator,pokemon tabletop sim,pokemon,pokemon card,pokemonsim,pokemon game sim,ptcg os,pokemon open source"/>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta http-equiv="Content-Language" content="en">
    <meta property="og:title" content="Pokémon TCG Tabletop Simulator | PTCG-sim"/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content="https://ptcgsim.online/src/assets/blank-logo.png"/>
    <meta property="og:url" content="https://ptcgsim.online"/>
    <meta property="og:description" content = "PTCG-sim is an open-source Pokémon Trading Card Game (Pokémon TCG) tabletop simulator supporting single player and online multiplayer. Simulate your favorite card game!">
    <meta property="og:site_name" content="PTCG-sim">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="src/assets/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="src/css/index.css">
    <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
    <script>
        // Server-side gate for the ?e2e=1 test bridge (see E2E_ENABLED in server/server.js).
        // Classic inline script: runs before the deferred module below, which reads this.
        window.__PTCG_E2E_ALLOWED = <%- JSON.stringify(Boolean(typeof e2eAllowed !== 'undefined' && e2eAllowed)) %>;
    </script>
    <!-- Must precede every module script. Vendored three.js for the Build & Battle 3D packs (design 055). -->
    <script type="importmap">{"imports":{"three":"/src/vendor/three/three.module.min.js"}}</script>
    <script type="module" src="src/front-end.js"></script>
    <script>
        window.onload = () => {
            var isMobile = /iPhone|iPad|iPod|Android|webOS|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            
            if (isMobile) {
                alert("PTCG-sim is still in mobile development. Please use a desktop for full functionality.");
            };
        };
    </script>
</head>
<%# /deck-builder renders this same page as the deck builder's own tab (design 050);
    /build-and-battle is that tab in Build & Battle mode (design 051). %>
<body<% if (isHomebrewBattle) { %> class="deck-builder-window build-battle-window etb-host"<% } else if (isBuildBattle) { %> class="deck-builder-window build-battle-window"<% } else if (isBuilderWindow) { %> class="deck-builder-window etb-host"<% } %>>
    <div id="importDataJSON" style="display: none;"><%= importDataJSON %></div>
    <div id="cover"></div>
    <div id="battleMat">
        <div id="battleMatTrim">
            <div id="battleMatSurface">
                <!-- Chosen playmat artwork. Hidden until a mat is picked, at
                     which point apply-mat-layout.js sets --mat-image and the
                     mat-one-player / mat-two-player mode class: a one-player
                     mat is drawn once per half (the far half rotated to face
                     that player), a full-size mat is drawn once across both. -->
                <div id="battleMatArt" hidden>
                    <div class="mat-half mat-half-opp"></div>
                    <div class="mat-half mat-half-self"></div>
                </div>
                <div id="battleMatSeam"></div>
                <div id="battleMatFloor"></div>
                <div id="battleMatGlow"></div>
            </div>
        </div>
    </div>
    <div id="board3dHost" hidden><canvas id="board3dCanvas" aria-hidden="true"></canvas><div id="boardMirror"><div id="selfBoard" class="self"></div><div id="oppBoard" class="opp"></div></div></div>
    <div id="stadium" class="outline"></div>
    

    <div id="boardButtonContainer">
        <button id="endTurnButton" type="button">End Turn</button>
        <div class="tooltip" id="passBoardButton">
            <button id="p2PassButton" class="self-color">Pass</button>
            <span class="tooltiptext">Pass</span>
        </div>
        <div class="tooltip" id="flipCoinButton">
            <button>Coin</button>
            <span class="tooltiptext">Flip coin</span>
        </div>
        <div class="tooltip" id="flipBoardButton">
            <button>⇅</button>
            <span class="tooltiptext">Flip board</span>
        </div>
        <div class="tooltip" id="refreshButton">
            <button><div id="refreshIcon">↻</div><div id="loadingCircle"></div></button>
            <span class="tooltiptext">Refresh images</span>
        </div>
        <div class="tooltip" id="fullscreenPlaymatButton">
            <button><div id="fullscreenIcon">⌞⌝</div></button>
            <span class="tooltiptext">Full screen</span>
        </div>
    </div>

    <div id="spectatorViewSwitch" role="group" aria-label="Spectator view" hidden>
        <span class="spectator-view-switch__label">Watching</span>
        <button type="button" data-mode="p1" aria-pressed="true">Player 1</button>
        <button type="button" data-mode="p2" aria-pressed="false">Player 2</button>
        <button type="button" data-mode="broadcast" aria-pressed="false">Both</button>
    </div>

    <div id="topButtonContainer">
        <button id="p1Button" class="selected-page">Solo</button>
        <button id="p2Button" class="not-selected-page">Multiplayer</button>
        <button id="deckImportButton" class="not-selected-page">Deck</button>
        <button id="settingsButton" class="not-selected-page">Settings</button>
    </div>
    <div id="greyFiller"></div>

    <div id="p1Box" class="sidebox">
        <div id="chatbox"></div>
        <div id="chatboxButtonContainer" class="chat-button-container">
            <button id="attackButton" class="self-color">Attack</button>
            <button id="retreatButton" class="self-color">Retreat</button>
            <button id="healButton" class="self-color">Heal</button>
            <button id="switchButton" class="self-color">Switch</button>
            <button id="attachButton" class="self-color">Attach</button>
            <button id="searchButton" class="self-color">Search</button>
            <button id="abilityButton" class="self-color">✦ Ability</button>
            <button id="stadiumButton" class="self-color">Stadium</button>
            <button id="energyRedirectButton" class="self-color">🔀 Redirect</button>
            <button id="undoButton" class="self-color">Undo</button>
            <button id="FREEBUTTON" class="self-color">🌺</button>
        </div>
        <input id="messageInput" type="text" placeholder="Type your message here...">
        <div id="bottomP1ButtonContainer" class="sidebox-button-container">
            <button id="setupButton" class="self-color">Set Up</button>
            <button id="resetButton" class="self-color">Reset</button>
            <button id="setupBothButton" class="neutral-color">Set Up Both</button>
            <button id="resetBothButton" class="neutral-color">Reset Both</button>
            <button id="restartButton" class="neutral-color">Restart</button>
            <button id="optionsButton" class="neutral-color">Options</button>
        </div>
    </div>
    <div id="p2Box" class="sidebox">
        <div id="p2ExplanationBox">
            <strong>Online Multiplayer Mode</strong>
            <div style="margin-top: 0.5em;"></div>
            Pick a room to play in, or watch a full one. To play with a friend privately, open "Private room" and share its ID.
        </div>
        <div id="lobby">
            <input id="nameInput" type="text" placeholder="Username" autocomplete="off" name="username">
            <div id="coachingModeLabel">
                <input type="checkbox" id="coachingModeCheckbox">
                <label style="cursor: pointer;" for="coachingModeCheckbox">Enable board flip <span style="font-style: italic; font-size: smaller;">(both players must enable)</span></label>
            </div>
            <ul id="publicRoomList" aria-label="Rooms" aria-live="polite"></ul>
            <details id="privateRoomDetails">
                <summary>Private room (with code)</summary>
                <div id="roomId">
                    <input id="roomIdInput" type="text" placeholder="Room ID">
                    <button id="copyButton">
                        <img src="https://www.svgrepo.com/show/309480/copy.svg" alt="Copy">
                    </button>
                    <button id="generateIdButton">Generate</button>
                </div>
                <div id="spectatorModeLabel">
                    <input type="checkbox" id="spectatorModeCheckbox">
                    <label style="cursor: pointer;" for="spectatorModeCheckbox">Join as spectator</label>
                </div>
                <div id="joinRoomButton"> Join Room </div>
            </details>
        </div>
        <div id="connectedRoom">
            <div id="roomHeader">
                <div id ="roomHeaderText"></div>
                <button id="roomHeaderCopyButton">
                    <img src="https://www.svgrepo.com/show/309480/copy.svg" alt="Copy">
                </button>
        </div>
            <div id="roomFormatPanel" aria-live="polite" hidden></div>
            <div id="p2Chatbox"></div>
            <div id="p2ChatboxButtonContainer" class="chat-button-container">
                <button id="p2AttackButton" class="self-color">Attack</button>
                <button id="p2RetreatButton" class="self-color">Retreat</button>
                <button id="p2HealButton" class="self-color">Heal</button>
                <button id="p2SwitchButton" class="self-color">Switch</button>
                <button id="p2AttachButton" class="self-color">Attach</button>
                <button id="p2SearchButton" class="self-color">Search</button>
                <button id="p2AbilityButton" class="self-color">✦ Ability</button>
                <button id="p2StadiumButton" class="self-color">Stadium</button>
                <button id="p2EnergyRedirectButton" class="self-color">🔀 Redirect</button>
                <!-- <button id="p2UndoButton" class="self-color">Undo</button> -->
                <button id="p2FREEBUTTON" class="self-color">🌺</button>
            </div>
            <input id="p2MessageInput" type="text" placeholder="Type your message here...">
            <div id="p2BottomButtonContainer" class="sidebox-button-container">
                <button id="p2SetupButton" class="self-color">Set Up</button>
                <button id="p2ResetButton" class="self-color">Reset</button>
                <button id="leaveRoomButton" class="neutral-color">Leave Room</button>
                <button id="p2OptionsButton" class="neutral-color">Options</button>
            </div>
        </div>
       
    </div>
    <!-- Deck tab: the deck builder opens in its own browser tab (design 050);
         this panel keeps only the per-player card back. -->
    <div id="deckImport" class="sidebox">
        <div id="importButtonContainer">
            <button id="mainImportHeaderButton" class="main-select">P1</button>
            <button id="altImportHeaderButton">P2 (Solo only)</button>
        </div>
        <div id="deckTabPanel">
            <p class="deck-tab-intro">Build and load decks in the <strong>Deck Builder</strong> tab. Press <strong>Play</strong> there to load the deck into this game.</p>
            <button id="openDeckBuilderButton" class="self-color">Open Deck Builder</button>
            <button id="openBuildBattleButton" class="self-color" title="Open a Phantasmal Flames Build &amp; Battle Box and build a 40-card deck (4 Prizes)">Build &amp; Battle</button>
            <button id="openHomebrewBattleButton" class="self-color" title="Open 30 Homebrew booster packs and build a 60-card deck (6 Prizes)">Homebrew Battle</button>
            <p id="deckBuilderBlockedText" class="deck-tab-warning" role="alert" hidden>Your browser blocked the new tab. Allow pop-ups for this site, then press the button again.</p>
        </div>
        <div id="uploadButtonsContainer">
            <button id="changeCardBackButton" class="self-color">Change Card Back</button>
        </div>
    </div>
    
    <div id="nativeDeckBuilderWorkspace" class="native-deck-builder-workspace db-live">
        <button id="nativeDeckBuilderEdgeToggle" class="native-deck-builder-edge-toggle" aria-label="Collapse deck builder workspace" title="Collapse deck builder workspace">❮</button>
        <div class="native-deck-builder-inner">
            <!-- One header row: title, which deck is being edited, and actions. -->
            <div class="native-deck-builder-header">
                <div>
                    <strong><%= isHomebrewBattle ? 'Homebrew Build & Battle' : isBuildBattle ? 'Build & Battle' : 'Deck Builder' %></strong>
                </div>
                <div class="native-deck-builder-targetbar">
                    <span class="native-deck-builder-target-label">Current Deck</span>
                    <div class="native-deck-builder-target-controls">
                        <button id="nativeDeckBuilderTargetMain" class="native-target-button native-target-selected">P1</button>
                        <button id="nativeDeckBuilderTargetAlt" class="native-target-button">P2 (Solo only)</button>
                    </div>
                    <div id="nativeDeckBuilderLibraryBar" class="native-deck-builder-deck-picker" data-target="self">
                        <button id="nativeDeckBuilderLibraryToggle" class="native-deck-builder-deck-picker-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nativeDeckBuilderLibraryPopover" title="My Decks">
                            <span class="native-deck-builder-deck-picker-label" data-deck-picker-label>Choose a deck</span>
                            <span aria-hidden="true">&#9662;</span>
                        </button>
                        <div id="nativeDeckBuilderLibraryPopover" class="native-deck-builder-deck-picker-popover" role="dialog" aria-label="My Decks" hidden>
                            <div id="nativeDeckBuilderLibraryList" class="native-deck-builder-library-list"></div>
                        </div>
                    </div>
                    <button id="nativeDeckBuilderNewDeck" class="native-deck-builder-new-deck" type="button">+ New Deck</button>
                    <span id="nativeDeckBuilderLibraryStatus" class="native-deck-builder-library-status" aria-live="polite"></span>
                    <button id="nativeDeckBuilderPlayButton" class="native-deck-builder-play-button" disabled>Play</button>
                </div>
                <div id="nativeDeckBuilderLinkBanner" class="native-deck-builder-link-banner" role="status" hidden>
                    Not connected to a game tab. Open the deck builder from the game's Deck tab to play; your decks still save here.
                </div>
                <div class="native-deck-builder-actions">
                    <button id="nativeDeckBuilderThemeToggle" class="native-deck-builder-theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">☀️</button>
                    <button id="nativeDeckBuilderExportCsv" class="self-color">Export Deck</button>
                    <button id="nativeDeckBuilderImportList" class="self-color" type="button" title="Paste a text decklist">Import List</button>
                    <label for="nativeDeckBuilderCsvImport" id="nativeDeckBuilderImportCsvLabel" class="self-color native-deck-builder-inline-label">Import Deck</label>
                    <input id="nativeDeckBuilderCsvImport" type="file" accept=".csv" style="display:none;" />
                </div>
            </div>
            <div class="native-deck-builder-body">
                <div class="native-deck-builder-pane native-deck-builder-pane-main">
                    <div class="native-deck-builder-mode-tabs">
                            <button id="nativeDeckBuilderTabSearch" class="native-deck-builder-mode-tab active" type="button">Search</button>
                            <button id="nativeDeckBuilderTabBrowse" class="native-deck-builder-mode-tab" type="button">Browse Sets</button>
                            <% if (isBuildBattle) { %>
                            <button id="buildBattleTabBox" class="native-deck-builder-mode-tab" type="button">Box</button>
                            <button id="buildBattleTabPool" class="native-deck-builder-mode-tab" type="button">Pool</button>
                            <% } else if (isBuilderWindow) { %>
                            <button id="nativeDeckBuilderTabSuggest" class="native-deck-builder-mode-tab" type="button" title="Card suggestions from tournament decklists">Suggest</button>
                            <button id="etbTabShelf" class="native-deck-builder-mode-tab" type="button">Shelf</button>
                            <button id="etbTabCollection" class="native-deck-builder-mode-tab" type="button">Collection</button>
                            <button id="nativeDeckBuilderTabCustomSet" class="native-deck-builder-mode-tab" type="button" title="Build your own set of cards, then save or export it for others">Custom Set</button>
                            <% } %>
                            <button id="nativeDeckBuilderTabCustomize" class="native-deck-builder-mode-tab" type="button">Customize</button>
                        </div>
                        <% if (isBuilderWindow && !isBuildBattle) { %>
                        <div id="nativeDeckBuilderCustomSetPanel" class="db-custom-set" hidden></div>
                        <% } %>
                        <div class="native-deck-builder-pane-main-header">
                        <div class="native-deck-builder-section-title-row">
                            <div class="native-deck-builder-section-title">Search</div>
                            <button id="nativeDeckBuilderAddCustomCard" class="neutral-color native-deck-builder-section-button">+ Custom Card</button>
                        </div>
                        <div class="native-deck-builder-search-row">
                            <input id="nativeDeckBuilderSearchInput" class="native-deck-builder-search-input" type="text" placeholder="Type a card name..." />
                            <select id="nativeDeckBuilderCardTypeFilter" class="native-deck-builder-search-select">
                                <option value="all">All</option>
                                <option value="tcg">TCG</option>
                                <option value="pocket">Pocket</option>
                            </select>
                            <select id="nativeDeckBuilderSortBy" class="native-deck-builder-search-select" aria-label="Sort by">
                                <option value="releaseDate">Release Date</option>
                                <option value="name">Name</option>
                                <option value="hp">HP</option>
                                <option value="number">Number</option>
                            </select>
                            <select id="nativeDeckBuilderSortDirection" class="native-deck-builder-search-select" aria-label="Sort direction">
                                <option value="desc">Desc</option>
                                <option value="asc">Asc</option>
                            </select>
                            <button id="nativeDeckBuilderSearchButton" class="self-color">Search</button>
                            <button id="nativeDeckBuilderFiltersButton" class="native-deck-builder-filters-button" type="button" aria-controls="nativeDeckBuilderFilterDrawer" aria-expanded="false">Filters <span class="native-deck-builder-filters-count" data-filters-count hidden>0</span></button>
                        </div>
                        <div id="nativeDeckBuilderFilterChips" class="native-deck-builder-fchips" aria-label="Active filters" hidden></div>
                        <div id="nativeDeckBuilderSearchStatus" class="native-deck-builder-search-status"></div>
                    </div>
                    <div class="native-deck-builder-results-shell">
                        <div id="nativeDeckBuilderSearchResults" class="native-deck-builder-search-results"></div>
                    </div>
                    <div id="nativeDeckBuilderSetBrowserPanel" class="native-deck-builder-set-browser" hidden>
                    </div>
                    <% if (isBuilderWindow && !isBuildBattle) { %>
                    <div id="nativeDeckBuilderSuggestPanel" class="native-deck-builder-suggest" hidden></div>
                    <% } %>
                    <% if (isBuildBattle) { %>
                    <div id="buildBattleBoxPanel" class="bb-panel" hidden></div>
                    <div id="buildBattlePoolPanel" class="bb-panel" hidden></div>
                    <% } else if (isBuilderWindow) { %>
                    <div id="etbShelfPanel" class="bb-panel" hidden></div>
                    <div id="etbCollectionPanel" class="bb-panel" hidden></div>
                    <% } %>
                    <div id="nativeDeckBuilderCustomizeSwitcher" hidden>
                      <div class="customize-switcher-toggle" role="tablist">
                        <button type="button" data-view="box" class="active">Deck Box</button>
                        <button type="button" data-view="sleeve">Card Sleeve</button>
                        <button type="button" data-view="coin">Coin</button>
                        <button type="button" data-view="mat">Mat</button>
                      </div>
                      <input id="nativeDeckBuilderCustomizeFilter" type="text"
                        placeholder="Filter deck boxes, sleeves, coins or mats..." aria-label="Filter customize items" />
                    </div>
                    <%# TCG Live's 3D preview of the deck's box, sleeve and coin (design 071); drawn above the active picker. %>
                    <div id="nativeDeckBuilderCustomizeStage" class="customize-stage" hidden></div>
                    <div id="nativeDeckBuilderBoxPanel" class="native-deck-builder-sleeve-panel native-deck-builder-box-panel" hidden></div>
                    <div id="nativeDeckBuilderSleevePanel" class="native-deck-builder-sleeve-panel" hidden>
                    </div>
    
                    <div id="nativeDeckBuilderCoinPanel" class="native-deck-builder-coin-picker" hidden></div>
                    <div id="nativeDeckBuilderMatPanel" class="native-deck-builder-mat-picker" hidden></div>
                    <!-- TCG Live filter drawer (design 050), shared by Search and Browse Sets:
                         slides over this pane from the left. -->
                    <div id="nativeDeckBuilderFilterScrim" class="native-deck-builder-fdrawer-scrim" hidden></div>
                    <div id="nativeDeckBuilderFilterDrawer" class="native-deck-builder-fdrawer" role="dialog" aria-label="Card filters" hidden></div>
                </div>
                
                <div class="native-deck-builder-pane native-deck-builder-pane-side">
                        <div class="native-deck-builder-deck-header">
                            <div class="native-deck-builder-deck-title">
                                <div id="nativeDeckBuilderDeckName" class="native-deck-builder-deck-name">Untitled Deck</div>
                                <div id="nativeDeckBuilderDeckSprites" class="native-deck-builder-deck-sprites is-empty"></div>
                                <div id="nativeDeckBuilderSpritePicker" class="native-deck-builder-sprite-picker" role="dialog" aria-label="Choose this deck's Pokémon" hidden></div>
                            </div>
                            <div class="native-deck-builder-deck-header-row">
                                <span id="nativeDeckBuilderValidationDot" class="native-deck-builder-validation-dot invalid" aria-label="Deck invalid" title="Deck invalid"></span>
                                <span id="nativeDeckBuilderDeckStatus" class="native-deck-builder-deck-status"></span>
                                <button id="nativeDeckBuilderSaveDeck" class="native-deck-builder-save-btn" type="button" title="Save this deck's cards, sleeve, coin and mat">Save</button>
                                <button id="nativeDeckBuilderClear" class="neutral-color native-deck-builder-clear-btn">Clear</button>
                            </div>
                        </div>
                        <div id="nativeDeckBuilderCounter" class="native-deck-builder-counter" role="status" aria-live="polite"></div>
                        <div id="nativeDeckBuilderSummaryPanel" class="native-deck-builder-summary"></div>
                        <div id="nativeDeckBuilderCardsPanel" class="native-deck-builder-cards"></div>
                        <div id="nativeDeckBuilderWallpaperSwitch" class="native-deck-builder-wallpaper-switch">
                            <button type="button" data-wallpaper-step="-1" aria-label="Previous box wallpaper" title="Previous box wallpaper">&#9664;</button>
                            <span class="native-deck-builder-wallpaper-name" data-wallpaper-name aria-live="polite">Forest</span>
                            <button type="button" data-wallpaper-step="1" aria-label="Next box wallpaper" title="Next box wallpaper">&#9654;</button>
                        </div>
                    </div></div>
            <% if (isBuilderWindow) { %>
            <nav id="nativeDeckBuilderPhoneNav" class="native-deck-builder-phone-nav" aria-label="Deck builder view">
                <button type="button" data-phone-view="cards" aria-pressed="true">Cards</button>
                <button type="button" data-phone-view="deck" aria-pressed="false">Deck <span id="nativeDeckBuilderPhoneCount"></span></button>
            </nav>
            <% } %>
            </div>
            <div id="nativeDeckBuilderImportListModal" class="native-deck-builder-modal" role="dialog" aria-modal="true" aria-label="Import card list" hidden>
                <div class="native-deck-builder-modal-box native-deck-builder-import-box">
                    <div class="native-deck-builder-modal-title">Import Card List</div>
                    <label class="native-deck-builder-modal-label">
                        Paste a decklist (Pokémon TCG Live, Limitless, or plain "4 Pikachu ex")
                        <textarea id="nativeImportListText" class="native-deck-builder-modal-input native-deck-builder-import-text" spellcheck="false" placeholder="4 Pikachu ex SVI 57&#10;4 Ultra Ball&#10;8 Basic {L} Energy"></textarea>
                    </label>
                    <div class="native-deck-builder-import-mode" role="radiogroup" aria-label="Import mode">
                        <label><input type="radio" name="nativeImportListMode" value="replace" checked /> Replace current deck</label>
                        <label><input type="radio" name="nativeImportListMode" value="add" /> Add to current deck</label>
                    </div>
                    <div id="nativeImportListStatus" class="native-deck-builder-import-status" aria-live="polite"></div>
                    <ul id="nativeImportListProblems" class="native-deck-builder-import-problems" hidden></ul>
                    <div class="native-deck-builder-modal-actions">
                        <button id="nativeImportListCancel" class="neutral-color" type="button">Close</button>
                        <button id="nativeImportListSubmit" class="self-color" type="button">Import</button>
                    </div>
                </div>
            </div>
            <div id="nativeDeckBuilderCustomCardModal" class="native-deck-builder-modal" role="dialog" aria-modal="true" aria-label="Add custom card" hidden>
                <div class="native-deck-builder-modal-box">
                    <div class="native-deck-builder-modal-title">Add Custom Card</div>
                    <div class="native-deck-builder-modal-body">
                        <div class="native-deck-builder-modal-fields">
                            <label class="native-deck-builder-modal-label">
                                Quantity
                                <input id="nativeCustomCardQty" class="native-deck-builder-modal-input" type="number" min="1" max="99" value="1" />
                            </label>
                            <label class="native-deck-builder-modal-label">
                                Card Name
                                <input id="nativeCustomCardName" class="native-deck-builder-modal-input" type="text" placeholder="e.g. Charizard" />
                            </label>
                            <label class="native-deck-builder-modal-label">
                                Card Type
                                <select id="nativeCustomCardType" class="native-deck-builder-modal-input">
                                    <option value="Pokémon">Pokémon</option>
                                    <option value="Trainer">Trainer</option>
                                    <option value="Energy">Energy</option>
                                </select>
                            </label>
                            <label class="native-deck-builder-modal-label">
                                Image URL
                                <input id="nativeCustomCardImageUrl" class="native-deck-builder-modal-input" type="url" placeholder="https://..." />
                            </label>
                        </div>
                        <div class="native-deck-builder-modal-preview">
                            <img id="nativeCustomCardPreviewImage" class="native-deck-builder-modal-preview-image" alt="Card preview" style="display:none;" />
                            <div id="nativeCustomCardPreviewPlaceholder" class="native-deck-builder-modal-preview-placeholder">No image</div>
                        </div>
                    </div>
                    <div id="nativeCustomCardError" class="native-deck-builder-modal-error" aria-live="polite"></div>
                    <div class="native-deck-builder-modal-actions">
                        <button id="nativeCustomCardCancel" class="neutral-color">Cancel</button>
                        <button id="nativeCustomCardSubmit" class="self-color">Add to Deck</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="nativeDeckBuilderCardPreviewScrim" class="native-deck-builder-card-preview-scrim" hidden>
        <img id="nativeDeckBuilderCardPreviewImage" class="native-deck-builder-card-preview-image" alt="Card preview" />
    </div>

