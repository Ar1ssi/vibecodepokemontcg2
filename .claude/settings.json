{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "enabledPlugins": {
    "context-engineering@context-engineering-marketplace": false,
    "render@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-edit-check.mjs\"",
            "timeout": 120,
            "statusMessage": "Linting and testing the edited file..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:bulbapedia.bulbagarden.net)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.tcgdex.net)",
      "WebFetch(domain:tcgdex.net)"
    ]
  }
}
